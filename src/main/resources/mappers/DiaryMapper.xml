<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.diary.backend.mapper.DiaryMapper">

    <!-- ============================= -->
    <!-- ResultMap -->
    <!-- ============================= -->
    <resultMap id="DiaryResultMap" type="com.diary.backend.vo.DiaryVO">
        <id property="id" column="id"/>
        <result property="memberId" column="member_id"/>
        <result property="content" column="content"/>
        <result property="emotion" column="emotion"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="isDeleted" column="is_deleted"/>
        <result property="nickname" column="nickname"/> <!-- ✅ 추가 -->
    </resultMap>


    <!-- ============================= -->
    <!-- Insert -->
    <!-- ============================= -->
    <insert id="insert"
            parameterType="com.diary.backend.vo.DiaryVO"
            useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO diary (member_id, content, emotion)
        VALUES (#{memberId}, #{content}, #{emotion})
    </insert>


    <!-- ============================= -->
    <!-- 단건 조회 (닉네임 포함) -->
    <!-- ============================= -->
    <select id="findById" resultMap="DiaryResultMap">
        SELECT d.*, m.nickname
        FROM diary d
                 JOIN member m ON d.member_id = m.id
        WHERE d.id = #{id}
          AND d.is_deleted = FALSE
    </select>


    <!-- ============================= -->
    <!-- 회원별 전체 조회 (닉네임 포함) -->
    <!-- ============================= -->
    <select id="findByMemberId" resultMap="DiaryResultMap">
        SELECT d.*, m.nickname
        FROM diary d
                 JOIN member m ON d.member_id = m.id
        WHERE d.member_id = #{memberId}
          AND d.is_deleted = FALSE
        ORDER BY d.created_at DESC
    </select>


    <!-- ============================= -->
    <!-- 감정 필터 + 페이징 (닉네임 포함) -->
    <!-- ============================= -->
    <select id="findByMemberIdWithEmotion" resultMap="DiaryResultMap">
        SELECT d.*, m.nickname
        FROM diary d
        JOIN member m ON d.member_id = m.id
        WHERE d.member_id = #{memberId}
        AND d.is_deleted = FALSE
        <if test="emotion != null">
            AND d.emotion = #{emotion}
        </if>
        ORDER BY d.created_at DESC
        LIMIT #{size} OFFSET #{offset}
    </select>


    <!-- ============================= -->
    <!-- 수정 -->
    <!-- ============================= -->
    <update id="update" parameterType="com.diary.backend.vo.DiaryVO">
        UPDATE diary
        SET content    = #{content},
            emotion    = #{emotion},
            updated_at = NOW()
        WHERE id = #{id}
          AND is_deleted = FALSE
    </update>


    <!-- ============================= -->
    <!-- 소프트 삭제 -->
    <!-- ============================= -->
    <update id="softDeleteById">
        UPDATE diary
        SET is_deleted = TRUE
        WHERE id = #{id}
    </update>

</mapper>