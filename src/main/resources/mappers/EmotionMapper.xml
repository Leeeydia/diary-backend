<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.diary.backend.mapper.EmotionMapper">

    <resultMap id="EmotionResultMap" type="com.diary.backend.vo.EmotionVO">
        <id property="id" column="id"/>
        <result property="diaryId" column="diary_id"/>
        <result property="emotionTag" column="emotion_tag"/>
        <result property="score" column="score"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <resultMap id="EmotionStatsResultMap" type="com.diary.backend.dto.response.EmotionStatsResponse">
        <result property="emotionTag" column="emotion_tag"/>
        <result property="count" column="cnt"/>
        <result property="averageScore" column="avg_score"/>
    </resultMap>

    <insert id="insert" parameterType="com.diary.backend.vo.EmotionVO" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO emotions (diary_id, emotion_tag, score)
        VALUES (#{diaryId}, #{emotionTag}, #{score})
    </insert>

    <insert id="insertBatch" parameterType="list">
        INSERT INTO emotions (diary_id, emotion_tag, score)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.diaryId}, #{item.emotionTag}, #{item.score})
        </foreach>
    </insert>

    <select id="findByDiaryId" resultMap="EmotionResultMap">
        SELECT * FROM emotions WHERE diary_id = #{diaryId}
    </select>

    <delete id="deleteByDiaryId">
        DELETE FROM emotions WHERE diary_id = #{diaryId}
    </delete>

    <select id="getStatsByUserId" resultMap="EmotionStatsResultMap">
        SELECT e.emotion_tag,
               COUNT(*)        AS cnt,
               AVG(e.score)    AS avg_score
        FROM emotions e
                 INNER JOIN diaries d ON e.diary_id = d.id
        WHERE d.user_id = #{userId}
        <if test="startDate != null and endDate != null">
            AND d.written_date BETWEEN #{startDate} AND #{endDate}
        </if>
        GROUP BY e.emotion_tag
        ORDER BY cnt DESC
    </select>

</mapper>
