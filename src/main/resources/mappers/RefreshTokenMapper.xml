<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.diary.backend.mapper.RefreshTokenMapper">

    <resultMap id="RefreshTokenResultMap" type="com.diary.backend.vo.RefreshTokenVO">
        <id property="id" column="id"/>
        <result property="memberId" column="member_id"/>
        <result property="token" column="token"/>
        <result property="expiresAt" column="expires_at"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="findByMemberId" resultMap="RefreshTokenResultMap">
        SELECT * FROM refresh_token WHERE member_id = #{memberId}
    </select>

    <select id="findByToken" resultMap="RefreshTokenResultMap">
        SELECT * FROM refresh_token WHERE token = #{token}
    </select>

    <insert id="upsert" parameterType="com.diary.backend.vo.RefreshTokenVO">
        INSERT INTO refresh_token (member_id, token, expires_at)
        VALUES (#{memberId}, #{token}, #{expiresAt})
        ON DUPLICATE KEY UPDATE
            token = VALUES(token),
            expires_at = VALUES(expires_at)
    </insert>

    <delete id="deleteByMemberId">
        DELETE FROM refresh_token WHERE member_id = #{memberId}
    </delete>

    <delete id="deleteExpiredTokens">
        DELETE FROM refresh_token WHERE expires_at &lt; NOW()
    </delete>

</mapper>
